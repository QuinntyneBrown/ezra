@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Register tool modules

interface IEzraModule {
  +ConfigureServices(services: IServiceCollection): void
  +CreateCommand(services: IServiceProvider): Command
}
class EzraApp {
  -modules: IReadOnlyList<IEzraModule>
  +RunAsync(args: string[], output: TextWriter, error: TextWriter, ct: CancellationToken): Task<int>
}
class "RootCommand <<System.CommandLine>>" as RootCommand
class "ServiceProvider <<DI>>" as ServiceProvider
interface "Capability interface" as Capability
class ScaffoldModule
ScaffoldModule ..|> IEzraModule
EzraApp "1" o-- "*" IEzraModule : composes
EzraApp ..> RootCommand : builds
EzraApp ..> ServiceProvider : builds
ServiceProvider ..> Capability : resolves
@enduml
